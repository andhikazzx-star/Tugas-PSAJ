# Apache Configuration – e-Rapor Sisipan
# Konfigurasi root untuk mengarahkan traffic ke folder public

Options -Indexes
Options -MultiViews

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sembunyikan file sensitif
    RewriteRule ^(app|bootstrap|config|database|routes|views|vendor)/ - [F,L]
    
    # Jika request bukan untuk folder public, forward secara transparan ke public
    RewriteCond %{REQUEST_URI} !^/public/
    RewriteRule ^(.*)$ public/$1 [L,QSA]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options DENY
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Blokir ekstensi/file file konfigurasi
<FilesMatch "\.(sql|md|log|env|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>
